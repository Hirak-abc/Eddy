# Eddy — Environment Variables
# Copy this file to .env and fill in real values. Never commit real secrets.

NODE_ENV=development
PORT=5001
CLIENT_URL=http://localhost:5173

# Clerk
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# Convex
CONVEX_URL=
EDDY_CONVEX_SECRET=

# xAI / Grok
XAI_API_KEY=

# Meta Graph API (backend only — never put secrets in client/.env)
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://eddy-api-d4n4.onrender.com/api/social/meta/callback
META_GRAPH_API_VERSION=v26.0
META_IG_GRAPH_API_VERSION=v21.0
META_STATE_SECRET=
META_TOKEN_ENCRYPTION_KEY=

# Server-managed test/publish accounts (optional — used when OAuth accounts are not stored)
META_PAGE_ID=
META_PAGE_NAME=
META_PAGE_ACCESS_TOKEN=
META_USER_ACCESS_TOKEN=
META_IG_USER_ID=
META_IG_USERNAME=
META_IG_ACCESS_TOKEN=
# Set true on machines whose Node.js TLS store does not trust a local proxy/antivirus.
META_TLS_INSECURE=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Google Analytics 4
VITE_GA_MEASUREMENT_ID=
